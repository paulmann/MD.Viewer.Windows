<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MdViewer.App</RootNamespace>
    <AssemblyName>mdview</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\mdview.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <TrimMode>partial</TrimMode>
    <IsTrimmable>false</IsTrimmable>
    <PublishReadyToRun>false</PublishReadyToRun>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);WFO1000;WFO5001;WFO5002</NoWarn>

    <!--
      Only the self-contained publish gets an .exe. A framework-dependent apphost in
      bin/ looks like a runnable program but demands the exact .NET 11 runtime and
      shows "You must install or update .NET" — exactly the trap a reader falls into.
      Every other build therefore produces mdview.dll, which cannot be mistaken for
      the shipped program; `build.ps1 -Task run` starts it through the SDK.
    -->
    <UseAppHost Condition="'$(SelfContained)' != 'true'">false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MdViewer.Core\MdViewer.Core.csproj" />
    <ProjectReference Include="..\MdViewer.Render\MdViewer.Render.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="app.manifest" />
  </ItemGroup>

</Project>



